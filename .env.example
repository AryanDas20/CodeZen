# Server
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
GUEST_TOKEN_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Firebase Web app config (public configuration; used by Firebase Auth in browser)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Firebase Admin credentials. Use ONE method:
# Option A: service account JSON as a single-line string (never commit this value)
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: path to service account file for local development only
GOOGLE_APPLICATION_CREDENTIALS=

# Supabase database + private file storage (server-only secret key)
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=brandweave-sources

# Optional Agent37 bridge adapter.
# Only set these after obtaining a documented endpoint and request schema for your Agent37 agent.
AGENT37_BRIDGE_URL=
AGENT37_BRIDGE_TOKEN=
AGENT37_INSTANCE_ID=
